---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalEmbed from "../components/CalEmbed.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import jsonLd from "../markup/offres/ld.json?raw";
import p0 from "../markup/offres/p0.html?raw";
import p1 from "../markup/offres/p1.html?raw";
import p2 from "../markup/offres/p2.html?raw";
---
<BaseLayout title="Prix et offres d'automatisation IA | ClickDroit" description="Premier robot, Pilote automatique ou Sur mesure : des prix fixes, annoncés avant de commencer. Installation en 10 jours, garantie des heures gagnées." pathname="/offres" jsonLd={jsonLd}>
<main id="contenu">
<Fragment set:html={p0} />
<Breadcrumbs items={[{"href": "/", "label": "Accueil"}, {"label": "Offres"}]} />
<Fragment set:html={p1} />
<CalEmbed />
<Fragment set:html={p2} />
</main>
</BaseLayout>
