---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalEmbed from "../components/CalEmbed.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import jsonLd from "../markup/ressources/ld.json?raw";
import p0 from "../markup/ressources/p0.html?raw";
import p1 from "../markup/ressources/p1.html?raw";
import p2 from "../markup/ressources/p2.html?raw";
---
<BaseLayout title="Vidéos et kits d'automatisation IA | ClickDroit" description="Des automatisations construites pas à pas en vidéo, avec l'article qui les explique, et des kits gratuits pour les artisans et les cabinets d'avocats." pathname="/ressources" noindex jsonLd={jsonLd}>
<main id="contenu">
<Fragment set:html={p0} />
<Breadcrumbs items={[{"href": "/", "label": "Accueil"}, {"label": "Ressources"}]} />
<Fragment set:html={p1} />
<CalEmbed />
<Fragment set:html={p2} />
</main>
</BaseLayout>
